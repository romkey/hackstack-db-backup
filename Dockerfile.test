FROM ruby:3.4-alpine

RUN apk add --no-cache build-base

WORKDIR /

COPY Gemfile Gemfile.lock ./
RUN gem install bundler -v "$(awk '/^BUNDLED WITH/{getline; print $1}' Gemfile.lock)" \
    && bundle install

COPY .rspec ./
COPY spec/ ./spec/
COPY app/ ./app/

CMD ["bundle", "exec", "rspec", "--format", "documentation"]
